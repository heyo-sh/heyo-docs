{
  "name": "heyo-docs-monorepo",
  "private": true,
  "packageManager": "bun@1.3.1",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "typecheck": "bun run --filter @heyo-sh/heyo-docs build && bun run --filter '*' typecheck",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "knip": "knip --include files,dependencies,unlisted,unresolved",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "bun-types": "1.4.0",
    "knip": "6.32.2",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
