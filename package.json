{
  "name": "heyo-docs-monorepo",
  "private": true,
  "packageManager": "bun@1.3.1",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "typecheck": "bun run --filter @heyo-sh/heyo-docs build && bun run --filter '*' typecheck",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "format-staged": "lint-staged",
    "prepare": "husky",
    "knip": "knip --include files,dependencies,unlisted,unresolved",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "bun-types": "1.4.0",
    "husky": "9.1.7",
    "knip": "6.33.0",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{astro,cjs,css,cts,html,js,json,jsonc,jsx,md,mdx,mjs,mts,ts,tsx,yaml,yml}": "prettier --write"
  }
}
