{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["examples/**"],
  "ignoreWorkspaces": ["examples/*"],
  "workspaces": {
    "packages/heyo-docs": {
      "entry": [
        "src/index.tsx",
        "src/adapters/vite/index.ts",
        "src/server/index.ts",
        "src/adapters/next/index.ts",
        "src/adapters/next/plugins.ts",
        "src/adapters/astro/index.ts",
        "src/config.ts",
        "src/link.ts",
        "src/mdx.ts",
        "src/openapi/index.ts",
        "src/openapi/request.ts",
        "src/seo/index.ts",
        "src/seo/next.ts",
        "src/seo/react-router.ts",
        "src/ai/index.ts",
        "src/theme/index.ts",
        "src/theme/provider.tsx",
        "src/theme/script.ts",
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx,css,mdx}",
        "scripts/**/*.ts",
        "test/**/*.ts"
      ],
      "ignoreFiles": ["src/theme/**/*.css", "src/theme/grain/brand-mark.tsx"],
      "ignoreDependencies": [
        "@opentelemetry/api",
        "shadcn",
        "tailwindcss",
        "tw-animate-css"
      ]
    },
    "packages/create-heyo-docs": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignore": ["templates/**"]
    }
  }
}
