{
  "name": "@heyo-sh/heyo-docs",
  "version": "0.1.1",
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@mdx-js/mdx": "3.1.0",
    "@remixicon/react": "^4.9.0",
    "beautiful-mermaid": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-frontmatter": "5.0.0",
    "shadcn": "^4.19.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.8.1",
    "zbsearch": "^4.0.0",
    "zod": "4.1.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./next-plugins": {
      "types": "./dist/next-plugins.d.ts",
      "default": "./dist/next-plugins.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "default": "./dist/astro.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "browser": "./dist/config.browser.js",
      "default": "./dist/config.js"
    },
    "./theme.css": "./dist/theme.css",
    "./theme/*.css": "./dist/theme/*.css"
  },
  "description": "A themeable documentation runtime for React Router Framework Mode.",
  "homepage": "https://docs.heyo.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyo-sh/heyo-docs.git"
  },
  "bugs": {
    "url": "https://github.com/heyo-sh/heyo-docs/issues"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run build --watch",
    "build": "bun run build:js && bun run build:types && bun run copy:assets",
    "clean": "rm -rf dist",
    "build:js": "bun build src/index.tsx --outdir dist --target browser --production --external react --external react-dom --external react/jsx-runtime --external zod --external zbsearch --external beautiful-mermaid --external react-markdown --external rehype-raw --external rehype-sanitize --external remark-gfm && bun build src/config.ts --outfile dist/config.browser.js --target browser --production --external zod && bun build src/vite.ts src/node.ts src/next.ts src/next-plugins.ts src/astro.ts src/config.ts --outdir dist --target node --production --external @mdx-js/mdx --external rehype-slug --external zod",
    "build:types": "tsc -p tsconfig.build.json",
    "copy:assets": "bun scripts/copy-theme-assets.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test"
  },
  "type": "module"
}
