  "scripts": {
    "dev": "bun run build --watch",
    "build": "bun run build:js && bun run build:types && bun run copy:assets",
    "clean": "rm -rf dist",
    "build:js": "bun build src/index.tsx --outdir dist --target browser --production --external react --external react-dom --external react/jsx-runtime --external zod --external zbsearch --external beautiful-mermaid --external react-markdown --external rehype-raw --external rehype-sanitize --external remark-gfm && bun build src/config.ts --outfile dist/config.browser.js --target browser --production --external zod && bun build --root src src/integrations/analytics/adobe.ts src/integrations/analytics/amplitude.ts src/integrations/analytics/clarity.ts src/integrations/analytics/clearbit.ts src/integrations/analytics/fathom.ts src/integrations/analytics/google-analytics.ts src/integrations/analytics/google-tag-manager.ts src/integrations/analytics/heap.ts src/integrations/analytics/hotjar.ts src/integrations/analytics/logrocket.ts src/integrations/analytics/mixpanel.ts src/integrations/analytics/openpanel.ts src/integrations/analytics/openreplay.ts src/integrations/analytics/pirsch.ts src/integrations/analytics/plausible.ts src/integrations/analytics/posthog.ts src/integrations/analytics/rybbit.ts src/integrations/analytics/swetrix.ts src/integrations/analytics/umami.ts src/integrations/support/chatwoot.ts src/integrations/support/chaskiq.ts src/integrations/support/front.ts src/integrations/support/intercom.ts src/integrations/support/papercups.ts src/integrations/support/typebot.ts src/integrations/support/zammad.ts src/integrations/consent/osano.ts src/integrations/consent/transcend.ts --outdir dist --target browser --production --external zod && bun build --root src src/vite.ts src/node.ts src/next.ts src/next-plugins.ts src/astro.ts src/config.ts --outdir dist --target node --production --external @mdx-js/mdx --external rehype-slug --external zod",
    "build:types": "tsc -p tsconfig.build.json",
    "copy:assets": "bun scripts/copy-theme-assets.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test"
  },
  "type": "module"
}
