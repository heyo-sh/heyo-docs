pters/astro/index.ts src/config.ts --outdir dist --target node --production --external @mdx-js/mdx --external rehype-slug --external zod && bun build src/openapi/request.ts --outfile dist/openapi/request.js --target browser --production && bun build src/components/integrations.tsx --outfile dist/browser-integrations.js --target browser --production --external react --external react-dom --external react/jsx-runtime --external zod && bun build src/theme/provider.tsx --outfile dist/theme/provider.js --target browser --production --banner='\"use client\";' --external react --external react-dom --external react/jsx-runtime && bun build src/theme/script.ts --outfile dist/theme/script.js --target browser --production && bun build src/ai/index.ts --outfile dist/ai/index.js --target node --production --external zod --external @mariozechner/pi-agent-core --external @mariozechner/pi-ai",
