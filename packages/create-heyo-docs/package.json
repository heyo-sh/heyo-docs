{
  "name": "@heyo-sh/create-heyo-docs",
  "version": "0.2.1",
  "description": "Create a standalone Heyo Docs documentation project.",
  "homepage": "https://heyo.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyo-sh/heyo-docs.git"
  },
  "bugs": {
    "url": "https://github.com/heyo-sh/heyo-docs/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "create-heyo-docs": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "deployments"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "0.10.0"
  },
  "scripts": {
    "dev": "bun run build --watch",
    "build": "bun build src/index.ts --outdir dist --target node --external @clack/prompts && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test"
  }
}
