{
  "name": "heyo-docs-react-router-example",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.1",
  "scripts": {
    "dev": "bun run --filter @heyo-sh/heyo-docs build && react-router dev",
    "build": "bun run --filter @heyo-sh/heyo-docs build && react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "bun run --filter @heyo-sh/heyo-docs build && react-router typegen && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@remixicon/react": "^4.9.0",
    "@react-router/node": "8.3.1",
    "beautiful-mermaid": "^1.1.3",
    "@heyo-sh/heyo-docs": "workspace:*",
    "isbot": "5.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1",
    "shadcn": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "zbsearch": "^4.0.0",
    "zod": "4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@react-router/dev": "8.3.1",
    "@react-router/serve": "8.3.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.5",
    "tailwindcss": "^4.1.14",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
