{
  "name": "heyo-docs-astro-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.1",
  "scripts": {
    "dev": "bun run --filter @heyo-sh/heyo-docs build && astro dev",
    "build": "bun run --filter @heyo-sh/heyo-docs build && astro build",
    "build:workspace": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "typecheck": "bun run --filter @heyo-sh/heyo-docs build && astro check",
    "typecheck:workspace": "astro check"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^6.0.4",
    "@fontsource-variable/figtree": "^5.3.0",
    "@remixicon/react": "^4.9.0",
    "astro": "7.2.10",
    "@heyo-sh/heyo-docs": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  }
}
