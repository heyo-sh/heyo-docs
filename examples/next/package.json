{
  "name": "heyo-docs-next-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.1",
  "scripts": {
    "predev": "bun run --filter @heyo-sh/heyo-docs build && tsx scripts/generate-heyo-docs.ts",
    "dev": "concurrently --kill-others-on-fail \"next dev\" \"tsx scripts/generate-heyo-docs.ts --watch\"",
    "build": "bun run --filter @heyo-sh/heyo-docs build && tsx scripts/generate-heyo-docs.ts && next build",
    "start": "next start",
    "typecheck": "bun run --filter @heyo-sh/heyo-docs build && tsx scripts/generate-heyo-docs.ts && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@remixicon/react": "^4.9.0",
    "@heyo-sh/heyo-docs": "workspace:*",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@next/mdx": "16.3.2",
    "@mdx-js/loader": "3.1.0",
    "@mdx-js/react": "3.1.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "concurrently": "^9.2.1",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
